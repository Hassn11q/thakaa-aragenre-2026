# Required only to rerun the consensus verifiers from scratch.
# The cached outputs let you reproduce the final submission without these keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash
GPT_MODEL_ID=gpt-5.6-luna

# OpenAI-compatible endpoint serving Gemma 4 31B IT.
JUDGE_BASE_URL=http://localhost:8000/v1
JUDGE_API_KEY=local-vllm
JUDGE_MODEL=google/gemma-4-31B-it

# Hugging Face repository used by the retrieval scripts.
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-8B
